<!DOCTYPE html>
<html>

<head>
  <title>Edit Blog</title>
</head>

<body>

  <h1>Edit Blog</h1>

  <form action="/edit/<%= blog.id %>?_method=PATCH" method="POST">

    <input type="text" name="title" value="<%= blog.title %>" required>

    <br><br>

    <textarea name="content"><%= blog.content %></textarea>

    <br><br>

    <button type="submit">Update</button>

  </form>

  <a href="/">Back</a>

</body>

</html>