<!DOCTYPE html>
<html>

<head>
  <title>Blog App</title>
</head>

<body>

  <h1>Blog Posts</h1>

  <a href="/create">Create Blog</a>

  <hr>

  <% blogs.forEach(blog=> { %>

    <% console.log('fetch all the data') %>

    <h2>
      <%= blog.title %>
    </h2>

    <p>
      <%= blog.content %>
    </p>

    <a href="/edit/<%= blog.id %>">Edit</a>

    <form action="/delete/<%= blog.id %>?_method=DELETE" method="POST">
      <button>Delete</button>
    </form>

    <hr>

    <% }) %>

</body>

</html>